# Настройки Bratik Core. Для изменения скопируй этот файл в .env.
PORT=3044
OLLAMA_URL=http://127.0.0.1:11434
BRATIK_MODEL=gpt-oss:20b
BRATIK_TIMEOUT_MS=180000

# Относительный путь считается от папки проекта, а не от Terminal.
# Для существующей базы можно указать абсолютный путь в кавычках:
# BRATIK_DB_PATH="/Users/your-name/Bratik-old/bratik.db"
BRATIK_DB_PATH=bratik.db

# Модель, выбранная в интерфейсе и сохранённая в этой базе,
# имеет приоритет над BRATIK_MODEL. Выбрать другую можно в интерфейсе.
# Отключение облака настраивается в самом Ollama, см. README.
# Переменные из этого файла не перенастраивают уже запущенный Ollama.
